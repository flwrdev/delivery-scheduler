{%- comment -%}
  FlowerBot storefront chat widget — floating bubble, bottom-right, anonymous
  (no customer login required). Backed by the same runAgentTurn brain the
  Messenger bot and customer-account chat use, via the App Proxy routes at
  /apps/schedule-rules/support-chat (see app/routes/apps.schedule-rules.support-chat.ts).

  page_visibility is evaluated here, in Liquid, so an excluded page never
  renders the container or loads the script — no flash-then-hide.
{%- endcomment -%}

{%- assign fc_show_widget = true -%}
{%- if block.settings.page_visibility != blank -%}
  {%- assign fc_show_widget = false -%}
  {%- assign fc_allowed_pages = block.settings.page_visibility | split: "," -%}
  {%- for fc_allowed_page in fc_allowed_pages -%}
    {%- assign fc_allowed_page = fc_allowed_page | strip -%}
    {%- if fc_allowed_page == request.page_type or fc_allowed_page == page.handle -%}
      {%- assign fc_show_widget = true -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if fc_show_widget -%}
  <div
    id="fc-chat-widget-root"
    data-greeting="{{ block.settings.greeting_text | escape }}"
    data-bubble-color="{{ block.settings.bubble_color }}"
    data-support-phone="{{ block.settings.support_phone | escape }}"
    data-logo-url="{{ 'flowercart-logo.png' | asset_url }}"
  ></div>
  {{ 'storefront-chat-widget.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'storefront-chat-widget.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "FlowerBot Chat Widget",
  "target": "body",
  "settings": [
    {
      "type": "textarea",
      "id": "page_visibility",
      "label": "Show only on these pages",
      "info": "Comma-separated list of page types (e.g. index, product, collection, page) or page handles (e.g. faqs, delivery-policy). Leave blank to show on every page."
    },
    {
      "type": "text",
      "id": "greeting_text",
      "label": "Greeting text",
      "default": "Hi! Ask us about bouquets, delivery dates, or your order status. 🌸"
    },
    {
      "type": "color",
      "id": "bubble_color",
      "label": "Bubble color",
      "default": "#9a6a60"
    },
    {
      "type": "text",
      "id": "support_phone",
      "label": "Support phone number",
      "default": "0962 422 4085"
    }
  ]
}
{% endschema %}
