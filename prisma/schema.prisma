// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// FlowerCart Messenger agent (phase 3+): Neon holds the CONVERSATION, never
// the order — Shopify is the order ledger (master doc, locked decision #1).
model MessengerThread {
  psid              String             @id
  humanControl      Boolean            @default(false)
  humanControlAt    DateTime?
  lastCustomerAt    DateTime?
  disclosedBot      Boolean            @default(false)
  state             String             @default("idle")
  shopifyCustomerId String?
  // Phase 6 slot-filling state machine: the fields collected so far for the
  // in-progress order (JSON, see MessengerOrderState). Conversation state
  // only — the order itself lives in Shopify (locked decision #1).
  orderStateJson    String?
  // Phase 6 idempotency guard: UUID written here BEFORE draftOrderCreate and
  // carried on the draft order as both a custom attribute and a tag
  // (mo-key-<uuid>). Check-before-create searches drafts by that tag.
  conversationOrderKey String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  messages          MessengerMessage[]
}

model MessengerMessage {
  id        String          @id @default(cuid())
  psid      String
  role      String // "customer" | "bot" | "operator" (phase 7: human echoes from Business Suite)
  bodyJson  String // JSON: { text } for now; richer shapes in later phases
  mid       String          @unique // webhook dedupe (Meta redelivers on non-200)
  // Set once the worker has successfully replied to this inbound message —
  // a Cloud Tasks retry that finds repliedAt set must NOT send again.
  repliedAt DateTime?
  replyMid  String?
  createdAt DateTime        @default(now())
  thread    MessengerThread @relation(fields: [psid], references: [psid])

  @@index([psid, createdAt])
}

// Lalamove courier-status listener (NOT dispatch — see ADR-16). Correlates a
// Lalamove delivery, booked manually by the merchant outside Shopify, to the
// Shopify order/fulfillment it belongs to, so a Lalamove COMPLETE status can
// auto-flip the Shopify fulfillment to DELIVERED. Polling-only as of the
// ADR-16 addendum (2026-08-16): Lalamove's push webhooks never fire for
// orders booked through the merchant's manual web flow (live-confirmed via
// the Lalamove Partner Portal's own "Webhook attempts" log), so rows are
// populated by recordLalamoveOrderId() — the merchant pasting the real
// Lalamove Order ID into the "Mark as fulfilled" modal — never by webhook or
// by parsing the merchant-facing tracking share link, which does not carry
// the real Lalamove order id.
model LalamoveTracking {
  id                   String    @id @default(cuid())
  shop                 String
  shopifyOrderId       String
  shopifyFulfillmentId String
  lalamoveOrderId      String    @unique
  status               String    @default("PENDING")
  deliveredAt          DateTime?
  lastPolledAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([shop, deliveredAt])
}

// Customer Email send log (E-5 revisit, docs/customer-email-design.md): logs
// that a merchant sent a customer email via the in-app compose modal, purely
// for the order panel's DeliveryTimeline display. Same side-table posture as
// LalamoveTracking above — an app-side log row, never Shopify delivery state,
// so it does not join the order write-path contract in docs/api.md.
model EmailSendLog {
  id             String   @id @default(cuid())
  shop           String
  shopifyOrderId String
  to             String
  subject        String
  sentAt         DateTime @default(now())

  @@index([shop, shopifyOrderId])
}

model DeliveryScheduleConfig {
  id                String   @id @default(cuid())
  shop              String   @unique
  timezone          String
  cutoffHour        Int
  prepHours         Int
  maxDays           Int
  slotsJson         String
  disabledDatesJson String
  disabledSlotsJson String
  slotCapacityJson  String
  // Optimistic-concurrency guard for granular section saves (Scheduler V2 §4.4):
  // writes send the version they loaded; a mismatch means another writer won.
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
