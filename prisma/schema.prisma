// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// FlowerCart Messenger agent (phase 3+): Neon holds the CONVERSATION, never
// the order — Shopify is the order ledger (master doc, locked decision #1).
model MessengerThread {
  psid              String             @id
  humanControl      Boolean            @default(false)
  humanControlAt    DateTime?
  lastCustomerAt    DateTime?
  disclosedBot      Boolean            @default(false)
  state             String             @default("idle")
  shopifyCustomerId String?
  // Phase 6 slot-filling state machine: the fields collected so far for the
  // in-progress order (JSON, see MessengerOrderState). Conversation state
  // only — the order itself lives in Shopify (locked decision #1).
  orderStateJson    String?
  // Phase 6 idempotency guard: UUID written here BEFORE draftOrderCreate and
  // carried on the draft order as both a custom attribute and a tag
  // (mo-key-<uuid>). Check-before-create searches drafts by that tag.
  conversationOrderKey String?
  // SUPERSEDED (2026-08-21): the anti-guessing lockout moved to the
  // channel-agnostic LookupAttempt model below, because this column pair is
  // keyed by psid and the web channels (customer-account/storefront) never
  // create a MessengerThread row. Left in place — dropping columns is
  // destructive — but no longer read or written by order-lookup.server.ts.
  lookupFailures    Int                @default(0)
  lookupLockedAt    DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  messages          MessengerMessage[]
}

// Channel-agnostic order-lookup anti-guessing guard (2026-08-21 addendum —
// see order-lookup.server.ts). Keyed by the resolved agent thread key (psid
// on Messenger, customer GID or anonymous conversation id on the web
// surfaces) so the lockout works the same regardless of which channel the
// customer is guessing from, and does not depend on a MessengerThread row
// existing for that key.
model LookupAttempt {
  key       String    @id
  failures  Int       @default(0)
  lockedAt  DateTime?
  updatedAt DateTime  @updatedAt
}

// Turn-volume rate limiting for LLM-backed agent channels (storefront widget,
// 2026-08-22) — distinct from LookupAttempt, which only throttles the
// order-lookup TOOL. This throttles general message/turn volume per caller.
// key is "conv:<conversationId>" or "ip:<address>" — opaque, no
// server-verified identity required. See agent-rate-limit.server.ts.
model AgentRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model MessengerMessage {
  id        String          @id @default(cuid())
  psid      String
  role      String // "customer" | "bot" | "operator" (phase 7: human echoes from Business Suite)
  bodyJson  String // JSON: { text } for now; richer shapes in later phases
  mid       String          @unique // webhook dedupe (Meta redelivers on non-200)
  // Set once the worker has successfully replied to this inbound message —
  // a Cloud Tasks retry that finds repliedAt set must NOT send again.
  repliedAt DateTime?
  replyMid  String?
  createdAt DateTime        @default(now())
  thread    MessengerThread @relation(fields: [psid], references: [psid])

  @@index([psid, createdAt])
}

// Lalamove courier-status listener (NOT dispatch — see ADR-16). Correlates a
// Lalamove delivery, booked manually by the merchant outside Shopify, to the
// Shopify order/fulfillment it belongs to, so a Lalamove COMPLETE status can
// auto-flip the Shopify fulfillment to DELIVERED. Polling-only as of the
// ADR-16 addendum (2026-08-16): Lalamove's push webhooks never fire for
// orders booked through the merchant's manual web flow (live-confirmed via
// the Lalamove Partner Portal's own "Webhook attempts" log), so rows are
// populated by recordLalamoveOrderId() — the merchant pasting the real
// Lalamove Order ID into the "Mark as fulfilled" modal — never by webhook or
// by parsing the merchant-facing tracking share link, which does not carry
// the real Lalamove order id.
model LalamoveTracking {
  id                   String    @id @default(cuid())
  shop                 String
  shopifyOrderId       String
  shopifyFulfillmentId String
  lalamoveOrderId      String    @unique
  status               String    @default("PENDING")
  deliveredAt          DateTime?
  lastPolledAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([shop, deliveredAt])
}

// Customer Email send log (E-5 revisit, docs/customer-email-design.md): logs
// that a merchant sent a customer email via the in-app compose modal, purely
// for the order panel's DeliveryTimeline display. Same side-table posture as
// LalamoveTracking above — an app-side log row, never Shopify delivery state,
// so it does not join the order write-path contract in docs/api.md.
model EmailSendLog {
  id             String   @id @default(cuid())
  shop           String
  shopifyOrderId String
  to             String
  subject        String
  sentAt         DateTime @default(now())

  @@index([shop, shopifyOrderId])
}

// Support chat (customer-account + storefront widget, agent-core phase 2/3):
// enqueue-then-poll job records for a chat turn. Neon holds the CONVERSATION
// + JOB STATUS only — same posture as MessengerThread/MessengerMessage
// (never the order; order state lives on the Shopify order).
// id is the customerGid for customer-account threads (one thread per
// signed-in customer); a "storefront:<uuid>" conversation id for the
// anonymous storefront widget (customerGid null there). `channel` is what
// runSupportChatTurn reads to reconstruct the right AgentChannel per job —
// see support-chat-turn.server.ts.
model SupportChatThread {
  id          String   @id
  shop        String
  customerGid String?
  channel     String   @default("customer-account") // "customer-account" | "storefront"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages SupportChatMessage[]
  jobs     SupportChatJob[]
}

model SupportChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String // "customer" | "assistant"
  bodyJson  String // JSON: { text } for a customer turn, { blocks } for an assistant turn
  createdAt DateTime @default(now())

  thread SupportChatThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
}

// One row per POST /api/support-chat call. The extension polls this by id
// (never by threadId) so a different customer's jobId cannot be guessed into
// leaking someone else's conversation — the poll route ALSO re-checks the
// caller's own verified customerGid against the job's thread before answering.
model SupportChatJob {
  id         String   @id // jobId returned to the client, crypto.randomUUID()
  threadId   String
  status     String   @default("pending") // "pending" | "done" | "failed"
  blocksJson String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  thread SupportChatThread @relation(fields: [threadId], references: [id])

  @@index([threadId, createdAt])
}

// Durable work record for the orders/create delivery sync (ADR-22, Phase A of
// docs/proposals/orders-async-jobs.md). Work BOOKKEEPING only — the Shopify
// order stays the delivery-state ledger; nothing here is ever read as delivery
// state. The row is the resume point: which idempotent sync step is already
// done (review finding S5) and whether the work is still owed (M1) — the
// webhook writes this row and acks fast, the Cloud Tasks worker does the
// actual sync with retries, the hourly sweep rescues stranded rows.
model DeliverySyncTask {
  id             String    @id @default(cuid())
  shop           String
  shopifyOrderId String
  orderName      String? // "#1046" — merchant-facing display in the ops banner
  // Work input, extracted once from the webhook payload — retries never need
  // the original payload again. Null deliveryDate/timeSlot = COD-fee-only task.
  deliveryDate   String?
  timeSlot       String?
  // Validation clock (D4/DEF-7, merchant constraint 2026-08-26): every retry
  // validates against the order's checkout time, never the retry time — a
  // delayed sync can never turn a legal checkout into "past cutoff".
  checkoutTime   DateTime
  needsCodFee    Boolean   @default(false)
  // Per-step ledger — steps with nothing to do are created already-true, so
  // "done" is always simply "all three flags true".
  metafieldsDone Boolean   @default(false)
  tagsDone       Boolean   @default(false)
  codFeeDone     Boolean   @default(false)
  status         String    @default("pending") // pending | done | failed
  // Double-processing guard (merchant constraint 2026-08-26): worker lease,
  // claimed via one conditional updateMany (null or stale = claimable) — see
  // claimDeliverySyncTask in delivery-sync-task.server.ts.
  lockedAt       DateTime?
  attempts       Int       @default(0)
  // "Not before" marker for the SWEEP only — Cloud Tasks retries pace
  // themselves via the queue's own backoff policy.
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  doneAt         DateTime?

  @@unique([shop, shopifyOrderId]) // webhook redelivery → same row, never a duplicate
  @@index([status, nextAttemptAt]) // the sweep query
  @@index([shop, status]) // the merchant-banner count query
}

// Bulk-action jobs (ADR-22 Phase B, docs/proposals/orders-async-jobs.md §3b —
// review finding S4): a /app/orders bulk op on MORE than BULK_INLINE_MAX
// orders becomes one job + per-order items instead of one long HTTP request.
// The Cloud Tasks worker processes items chunk-by-chunk (re-enqueueing itself
// between chunks) so every request stays small; the client polls the job by
// id. Work BOOKKEEPING only — the order writes land on Shopify exactly as the
// inline path's do (same shared executor, so the two can't drift).
model BulkActionJob {
  id         String    @id @default(cuid()) // returned to the client for polling
  shop       String
  action     String // BulkActionName
  paramsJson String // validated BulkOpParams snapshot (validation happens BEFORE job creation)
  status     String    @default("queued") // queued | running | done | failed
  // Double-processing guard (§2a): job-level lease, renewed every chunk;
  // items additionally claim pending → processing before execution.
  lockedAt   DateTime?
  totalCount Int
  okCount    Int       @default(0)
  failCount  Int       @default(0)
  lastError  String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt
  items      BulkActionJobItem[]

  @@index([shop, status, createdAt]) // status polling scope check
  @@index([status, updatedAt]) // the sweep's stranded-job rescue query
}

model BulkActionJobItem {
  id             String  @id @default(cuid())
  jobId          String
  shopifyOrderId String
  orderName      String?
  status         String  @default("pending") // pending | processing | ok | failed
  message        String? // same per-item message the inline BulkActionItemResult carries
  updatedAt      DateTime @updatedAt
  job            BulkActionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, shopifyOrderId])
  @@index([jobId, status])
}

model DeliveryScheduleConfig {
  id                String   @id @default(cuid())
  shop              String   @unique
  timezone          String
  cutoffHour        Int
  prepHours         Int
  maxDays           Int
  slotsJson         String
  disabledDatesJson String
  disabledSlotsJson String
  slotCapacityJson  String
  // Optimistic-concurrency guard for granular section saves (Scheduler V2 §4.4):
  // writes send the version they loaded; a mismatch means another writer won.
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Merchant-editable storefront chat widget copy/colors, set from the app's
// Messenger admin page (merchant chose to fold widget settings into that
// page rather than a dedicated nav item, 2026-08-23). Null column = use the
// built-in default in widget-config.server.ts. Read by
// apps.schedule-rules.widget-config.ts (App Proxy) on every storefront page
// load, so widget-config.server.ts caches this in-process; the Theme Editor
// block settings in app-embed.liquid are NOT removed — they stay as the
// fallback if this row doesn't exist yet or the fetch fails.
model WidgetConfig {
  shop         String   @id
  greeting     String?
  bubbleColor  String?
  supportPhone String?
  trackLabel   String?
  chip2Label   String?
  chip2Message String?
  chip3Label   String?
  chip3Message String?
  chip4Label   String?
  chip4Message String?
  // Colors/layout/behavior (2026-08-23 addendum) -- same null=default
  // convention as the fields above. position/panelSize are validated
  // against a fixed string set at the app layer (see app.messenger-orders.tsx),
  // not a Prisma enum, to match how bubbleColor is already hex-validated
  // there rather than DB-constrained.
  panelBg        String?
  textColor      String?
  mutedColor     String?
  borderColor    String?
  panelSize      String? // "compact" | "standard" | "large"
  cornerRadius   Int?
  position       String? // "left" | "right"
  disclaimerText String?
  showDisclaimer Boolean?
  autoHideBubble Boolean?
  updatedAt      DateTime @updatedAt
}
