{
  "name": "delivery-scheduler",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev --config shopify.app.toml",
    "dev:prod-preview": "shopify app dev --config shopify.app.production.toml",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "echo Specify npm run deploy:dev or npm run deploy:prod -- a bare deploy is disabled to prevent hitting the wrong app && exit 1",
    "deploy:dev": "shopify app deploy --config shopify.app.toml --allow-updates",
    "deploy:prod": "shopify app deploy --config shopify.app.production.toml --allow-updates",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "test": "vitest run",
    "test:extensions": "vitest run --config vitest.extensions.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit && tsc -p tsconfig.extension-tests.json --noEmit"
  },
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify-api": "^14.0.1",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "dotenv": "^16.6.1",
    "isbot": "^5.1.31",
    "nodemailer": "^9.0.3",
    "prisma": "^7.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.1",
    "@shopify/ui-extensions-tester": "2026.4.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.8"
  }
}
