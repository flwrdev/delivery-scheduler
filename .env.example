DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SCOPES="read_orders,write_orders,read_customers,write_products,read_metaobjects,write_metaobjects,write_metaobject_definitions"
SHOPIFY_APP_URL="https://replace-with-your-cloud-run-url.a.run.app"
NODE_ENV="development"
# Private Storefront API access token used only by
# app/routes/apps.schedule-rules.products.ts (collection "Show more" pagination).
# Create via Shopify Admin > Settings > Apps > Develop apps > [your app] > API credentials
# (or the Headless sales channel) — not settable via Shopify CLI.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Customer Email (docs/customer-email-design.md §3) — server-side send through
# the merchant's business mailbox (Namecheap Private Email, plain SMTP AUTH).
# When USER/PASSWORD are absent the sendEmail op returns a clear
# "not configured" error instead of crashing (expected on fresh checkouts).
EMAIL_SMTP_HOST="mail.privateemail.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM_NAME=""
# FlowerCart Messenger webhook (phase 2 echo bot) — Meta app 1065300189364788.
# Real values live in Google Secret Manager (PAGE_ID is a plain env var).
# All four may stay empty on fresh checkouts: the webhook route returns
# designed 403/401/"not configured" failures instead of crashing.
MESSENGER_APP_SECRET=""
MESSENGER_VERIFY_TOKEN=""
MESSENGER_PAGE_ACCESS_TOKEN=""
MESSENGER_PAGE_ID=""
MESSENGER_TASKS_QUEUE_PATH=""
MESSENGER_WORKER_URL=""
MESSENGER_WORKER_SECRET=""
MESSENGER_SHOP=""
MESSENGER_FOLLOWUP_HOURS=""
ANTHROPIC_API_KEY=""
# Occasion reminder emails (ADR-19) — nightly Cloud Scheduler job POSTs to
# /internal/reminder-scan with the shared-secret header; sends reuse the
# EMAIL_SMTP_* mailbox above. All three may stay empty on fresh checkouts:
# the scan route answers 401/"not configured", and sends are HELD when the
# unsubscribe secret is missing (never email without a working opt-out link).
REMINDER_SCAN_SECRET=""
REMINDER_SHOP=""
REMINDER_UNSUBSCRIBE_SECRET=""
# Delivery-sync work queue (ADR-22) — all three are OPTIONAL: each falls back
# to its Messenger equivalent above (OPS_WORKER_SECRET → MESSENGER_WORKER_SECRET,
# OPS_TASKS_QUEUE_PATH → MESSENGER_TASKS_QUEUE_PATH, DELIVERY_SYNC_WORKER_URL →
# derived from MESSENGER_WORKER_URL by path swap), so Phase A runs with zero new
# infra. Set them only to isolate the ops rail from the Messenger queue. With no
# queue configured at all (local dev), the webhook processes the sync inline.
OPS_WORKER_SECRET=""
OPS_TASKS_QUEUE_PATH=""
DELIVERY_SYNC_WORKER_URL=""
BULK_ACTION_WORKER_URL=""
# Google Maps key for the Edit-details address search (/app/orders modal).
# Needs "Maps JavaScript API" + "Places API (New)" enabled on the Google Cloud
# project; the key ships to the browser by design, so restrict it by HTTP
# referrer (prod app URL). Empty = the search field is simply hidden and the
# manual address form keeps working.
GOOGLE_MAPS_API_KEY=""
