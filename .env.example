# Local development points at the Neon `dev` branch, never at `production`
# (docs/development.md "Database: production branch vs dev branch").
DATABASE_URL="postgresql://USER:PASSWORD@DEV-BRANCH-POOLER-HOST/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DEV-BRANCH-DIRECT-HOST/neondb?sslmode=require"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SCOPES="read_orders,write_orders,read_customers,write_products,read_metaobjects,write_metaobjects,write_metaobject_definitions"
SHOPIFY_APP_URL="https://replace-with-your-cloud-run-url.a.run.app"
NODE_ENV="development"
# Private Storefront API access token used only by
# app/routes/apps.schedule-rules.products.ts (collection "Show more" pagination).
# Create via Shopify Admin > Settings > Apps > Develop apps > [your app] > API credentials
# (or the Headless sales channel) — not settable via Shopify CLI.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Customer Email (docs/customer-email-design.md §3) — server-side send through
# the merchant's business mailbox (Namecheap Private Email, plain SMTP AUTH).
# When USER/PASSWORD are absent the sendEmail op returns a clear
# "not configured" error instead of crashing (expected on fresh checkouts).
EMAIL_SMTP_HOST="mail.privateemail.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM_NAME=""
# Ops work queue (Cloud Tasks) for the orders/create delivery sync and the
# /app/orders bulk-action jobs. Read by app/services/ops-queue.server.ts.
# Legacy names still accepted as fallbacks while Cloud Run is migrated:
# MESSENGER_WORKER_SECRET, MESSENGER_TASKS_QUEUE_PATH, MESSENGER_WORKER_URL.
# With no queue configured at all (local dev), the webhook processes the
# sync inline.
OPS_WORKER_SECRET=""
OPS_TASKS_QUEUE_PATH=""
# Base URL of this app (scheme + host). Worker URLs are derived from it as
# <base>/webhooks/delivery-sync/worker and <base>/webhooks/bulk-action/worker
# unless the explicit per-worker vars below are set.
OPS_WORKER_BASE_URL=""
DELIVERY_SYNC_WORKER_URL=""
BULK_ACTION_WORKER_URL=""
# The single shop this app manages (myshopify domain). Read by
# app/lib/shop-domain.server.ts; MESSENGER_SHOP / LALAMOVE_SHOP are the older
# names and still work as fallbacks.
SHOP_DOMAIN=""
# Meta Page ID (numeric). Used only to build the Business Suite inbox deep
# link on /app/orders; MESSENGER_PAGE_ID is the older name and still works.
META_PAGE_ID=""
# Google Maps key for the Edit-details address search (/app/orders modal).
# Needs "Maps JavaScript API" + "Places API (New)" enabled on the Google Cloud
# project; the key ships to the browser by design, so restrict it by HTTP
# referrer (prod app URL). Empty = the search field is simply hidden and the
# manual address form keeps working.
GOOGLE_MAPS_API_KEY=""
