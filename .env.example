# Copy to .env and fill in. .env is gitignored: never commit real values.
# Full explanation of every variable: docs/development.md, section 6.

# Database. Point these at YOUR OWN Postgres (local, Docker or your own Neon
# project), never at production. DATABASE_URL is used by the app (can be
# pooled); DIRECT_DATABASE_URL is used by the Prisma CLI (must be direct).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Shopify app. `shopify app dev` sets these for you; fill them only when you
# run the server outside the CLI. SCOPES matches shopify.app.production.toml.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SCOPES="read_orders,write_orders,write_order_edits,read_customers,write_products,write_payment_customizations,read_metaobjects,write_metaobjects,write_metaobject_definitions,read_fulfillments,write_fulfillments,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,write_files,read_files,read_draft_orders,write_draft_orders"
SHOPIFY_APP_URL="https://your-tunnel-or-app-url.example"
NODE_ENV="development"

# The one store this app serves, e.g. your-dev-store.myshopify.com.
SHOP_DOMAIN=""
# Optional: the store's own domain, if it has one.
SHOP_CUSTOM_DOMAIN=""

# Optional. Storefront API token, used only by
# app/routes/apps.schedule-rules.products.ts (collection "Show more" paging).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Optional. Customer email: send over SMTP, read replies over IMAP.
# Without USER/PASSWORD the send returns a "not configured" error.
# IMAP reuses USER/PASSWORD; host defaults to EMAIL_SMTP_HOST, port to 993.
EMAIL_SMTP_HOST="mail.privateemail.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM_NAME=""
EMAIL_IMAP_HOST=""
EMAIL_IMAP_PORT=""

# Optional. Google Maps Places key for address search (browser only).
GOOGLE_MAPS_API_KEY=""
# Optional. Facebook page id for the link on the Orders page.
META_PAGE_ID=""
