{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "npm install",
      "inAgents": true,
      "runOptions": {
        "runOn": "worktreeCreated"
      }
    },
    {
      "label": "Start dev server",
      "type": "shell",
      "command": "npm run dev",
      "inAgents": true,
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*",
          "endsPattern": ".*ready on.*"
        }
      }
    },
    {
      "label": "Build for production",
      "type": "shell",
      "command": "npm run build",
      "inAgents": true
    },
    {
      "label": "Run tests (watch)",
      "type": "shell",
      "command": "npm run test:watch",
      "inAgents": true,
      "isBackground": true
    },
    {
      "label": "Lint code",
      "type": "shell",
      "command": "npm run lint",
      "inAgents": true
    }
  ]
}
