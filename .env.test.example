# E2E (Playwright) live-test environment.
# Copy this file to .env.test and fill in the blanks — the Playwright config
# loads .env.test automatically. .env.test is gitignored; NEVER commit real values.
#
# ⚠️ SAFETY: the suite performs a REAL reschedule on a REAL order in the store.
#    Point TEST_ORDER_GID at a safe test/archived order, never a live customer
#    order, and run it deliberately (it is excluded from `npm test` and CI).

# Public URL of the deployed app (prod Cloud Run, or a dev tunnel URL)
APP_URL=https://delivery-scheduler-299861709433.us-central1.run.app

# App API key = client_id in shopify.app.production.toml
SHOPIFY_API_KEY=

# App API secret (Partner Dashboard / Secret Manager) — signs the test session token
SHOPIFY_API_SECRET=

# Store under test
SHOP_DOMAIN=hsrwva-nr.myshopify.com

# Optional offline admin token (shpua_…) with read_orders + write_orders.
# If omitted, the suite falls back to the app's stored offline session in
# Postgres — in that case DATABASE_URL below must also be filled in.
ADMIN_ACCESS_TOKEN=

# Needed ONLY for the ADMIN_ACCESS_TOKEN fallback (copy the value from .env)
DATABASE_URL=

# The order to reschedule (a SAFE test order) and the customer who owns it
TEST_ORDER_GID=gid://shopify/Order/0000000000000
TEST_CUSTOMER_GID=gid://shopify/Customer/0000000000000

# New target selection — must be allowed by the CURRENT schedule rules
# (future date inside the booking window, not blocked, slot exists, not full)
TEST_NEW_DATE=
TEST_NEW_TIME_SLOT=3PM-6PM
