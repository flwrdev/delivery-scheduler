      {%- assign _cod_fee_has_line_item = false -%}
      {%- assign _cod_fee_is_cod_order = false -%}
      {%- assign _cod_fee_is_percentage = false -%}
      {%- assign _cod_fee_percentage_minimal = false -%}
      {%- assign _cod_fee_is_taxable = false -%}
      {%- assign _cod_fee_tax_additional = 0 -%}
      {%- assign _cod_fee_commission_name = shop.metafields._cod_fee.commission_name -%}
      {%- unless metafields._cod_fee.commission_name == "" or metafields._cod_fee.commission_name == nil -%}
      {%- assign _cod_fee_commission_name = metafields._cod_fee.commission_name -%}
      {%- endunless -%}
      {%- if _cod_fee_commission_name contains "{taxable_fee}" -%}
      {%- assign _cod_fee_commission_name = _cod_fee_commission_name | replace: "{taxable_fee}", "" -%}
      {%- assign _cod_fee_is_taxable = true -%}
      {%- endif -%}
      {%- if _cod_fee_commission_name contains "{percentage_fee}" -%}
      {%- assign _cod_fee_commission_name = _cod_fee_commission_name | replace: "{percentage_fee}", "" -%}
      {%- assign _cod_fee_is_percentage = true -%}
      {%- if _cod_fee_commission_name contains "{minimal_precentage}" -%}
      {%- assign _cod_fee_commission_name_middleman = _cod_fee_commission_name | split: "{minimal_precentage}" -%}
      {%- assign _cod_fee_commission_name = _cod_fee_commission_name_middleman[0] -%}
      {%- assign _cod_fee_percentage_minimal = _cod_fee_commission_name_middleman[1] | plus: 0 -%}
      {%- endif -%}
      {%- endif -%}

      {%- assign other_settings = shop.metafields._cod_fee.other_settings -%}
      {%- assign settings_parts = other_settings | split: ',' -%}
      {%- assign percentageTotalType = '' -%}
      {%- assign percentageMinimal = '' -%}
      {%- for part in settings_parts -%}
        {%- if part contains '"percentageMinimal":' -%}
          {%- assign pm_tmp = part | split: ':' | last | remove: '}' | remove: '"' | strip -%}
          {%- assign percentageMinimal = pm_tmp -%}
        {%- endif -%}
        {%- if part contains '"percentageTotalType":' -%}
          {%- assign ptt_tmp = part | split: ':' | last | remove: '}' | remove: '"' | strip -%}
          {%- assign percentageTotalType = ptt_tmp -%}
        {%- endif -%}
      {%- endfor -%}

      {%- for transaction in transactions -%}
      {%- if transaction.status == "success" or transaction.status == "pending" -%}
      {%- if transaction.gateway == shop.metafields._cod_fee.gateway_name -%}
      {%- assign _cod_fee_is_cod_order = true -%}
      {%- endif -%}
      {%- endif -%}
      {%- endfor -%}
      {%- assign _cod_fee_commission = shop.metafields._cod_fee.commission -%}
      {%- unless metafields._cod_fee.commission == "" or metafields._cod_fee.commission == nil -%}
      {%- assign _cod_fee_commission = metafields._cod_fee.commission -%}
      {%- assign _cod_fee_is_cod_order = true -%}
      {%- endunless -%}
      {%- if _cod_fee_is_percentage -%}
      {%- assign _cod_fee_commission_base = total_price -%}
      {%- if percentageTotalType == 'subtotal-only' -%}
        {%- assign _cod_fee_commission_base = subtotal_price -%}
      {%- endif -%}

      {%- assign _cod_fee_commission_percentage = _cod_fee_commission -%}
      {%- assign _cod_fee_commission = _cod_fee_commission_base | times: _cod_fee_commission_percentage | divided_by: 10000 -%}
      {%- assign _order_price_valid = _cod_fee_commission_base | divided_by: 100 -%}
      {%- assign _percentage_valid = _cod_fee_commission_percentage | divided_by: 10000.0 -%}
      {%- assign _final_value_to_check = _order_price_valid | times: _percentage_valid -%}
      {%- if _cod_fee_percentage_minimal -%}
      {%- if _final_value_to_check < _cod_fee_percentage_minimal -%}
      {%- assign _cod_fee_commission = _cod_fee_percentage_minimal | times: 100 -%}
      {%- endif -%}
      {%- endif -%}
      {%- endif -%}
      {%- for line in subtotal_line_items -%}
      {%- if line.title == _cod_fee_commission_name -%}
      {%- assign _cod_fee_has_line_item = true -%}
      {%- endif -%}
      {%- endfor -%}
      {%- assign _cod_fee_custom_message_email = "" -%}
      {%- if _cod_fee_is_cod_order == true and shop.metafields._cod_fee.custom_message_email != "_none" -%}
      {%- assign _cod_fee_custom_message_email = shop.metafields._cod_fee.custom_message_email -%}
      {%- endif -%}
      {%- assign _cod_fee_subtotal_price = subtotal_price -%}
      {%- assign _cod_fee_total_price = total_price -%}
      {%- assign _cod_fee_tax_price = tax_price -%}
      {%- if _cod_fee_is_taxable == true and _cod_fee_has_line_item == false and _cod_fee_is_cod_order == true and tax_price > 0 -%}
      {%- assign _cod_fee_taxable_subtotal = subtotal_price | plus: shipping_price | plus: tax_price -%}
      {%- if _cod_fee_taxable_subtotal <= total_price -%}
      {%- assign _cod_fee_total_minus_tax = total_price | minus: tax_price -%}
      {%- assign _cod_fee_tax_rate = tax_price | times: 100000 | divided_by: _cod_fee_total_minus_tax -%}
      {%- assign _cod_fee_tax_additional = _cod_fee_commission | times: _cod_fee_tax_rate | divided_by: 100000 -%}
      {%- assign _cod_fee_tax_price = tax_price | plus: _cod_fee_tax_additional -%}
      {%- else -%}
      {%- assign _cod_fee_tax_rate = tax_price | times: 100000 | divided_by: total_price -%}
      {%- assign _cod_fee_total_with_fee = total_price | plus: _cod_fee_commission -%}
      {%- assign _cod_fee_tax_price = _cod_fee_total_with_fee | times: _cod_fee_tax_rate | divided_by: 100000 -%}
      {%- endif -%}
      {%- endif -%}
      {%- if _cod_fee_has_line_item == false and _cod_fee_is_cod_order == true -%}
      {%- assign _cod_fee_subtotal_price = subtotal_price | plus: _cod_fee_commission -%}
      {%- assign _cod_fee_total_price = total_price | plus: _cod_fee_commission | plus: _cod_fee_tax_additional -%}
      {%- endif -%}
      {%- capture _cod_fee_total_price_formatted -%}
      <b>{{- _cod_fee_total_price | money -}}</b>
      {%- endcapture -%}
      {%- assign _cod_fee_custom_message_email = _cod_fee_custom_message_email | replace: '{order_total}', _cod_fee_total_price_formatted -%}
      {%- capture _cod_fee_commission_line_item -%}
      {%- if _cod_fee_has_line_item == false and _cod_fee_is_cod_order == true -%}
      <tr class="order-list__item">
        <td class="order-list__item__cell">
          <table>
            <td>
            </td>
            <td class="order-list__product-description-cell">
              <span class="order-list__item-title">{{ _cod_fee_commission_name -}}</span>
            </td>
            <td class="order-list__price-cell">
              <p class="order-list__item-price">{{ _cod_fee_commission | money -}}</p>
            </td>
          </table>
        </td>
      </tr>
      {%- endif -%}
      {%- endcapture -%}
